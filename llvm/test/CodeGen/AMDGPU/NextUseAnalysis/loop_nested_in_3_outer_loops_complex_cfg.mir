#                   bb.6.Flow4                     |  |  |
#                       |                          |  |  |
#                   bb.10.bb3                      |  |  |
#                    /  |                          |  |  |
#            bb.11.bb4  |                          |  |  |
#                    \  |                          |  |  |
#               bb.12.loop3.latch------------------+  |  |
#                       |                             |  |
#               bb.13.loop2.latch---------------------+  |
#                       |                                |
#               bb.14.loop1.latch------------------------+
